# ============================================================
# FAMMA MENNOU — configuration de deploiement
#
# Copier ce fichier en `.env.deploy` puis le remplir. `.env.deploy` est
# ignore par Git : il contient l'hote, l'identifiant et parfois un mot de
# passe. Ne jamais le committer, ne jamais le coller dans une conversation.
#
#   cp scripts/deploy/.env.deploy.example scripts/deploy/.env.deploy
# ============================================================

# --- Mode de transfert ---------------------------------------
# ssh : rsync par SSH. Le mode a preferer — incrementiel, verifie, sans
#       mot de passe si une cle est en place.
# ftp : lftp en FTPS explicite, pour les paliers DirectAdmin sans SSH.
#       Jamais de FTP en clair : le mot de passe traverserait le reseau
#       en clair.
DEPLOY_MODE=ssh

# --- Hote -----------------------------------------------------
DEPLOY_HOST=
DEPLOY_USER=

# Port SSH. Oxahost n'utilise pas toujours 22 — le verifier dans le panneau
# avant le premier transfert.
DEPLOY_PORT=22

# --- Chemin distant -------------------------------------------
# Convention DirectAdmin. LE VERIFIER dans le gestionnaire de fichiers du
# panneau avant le premier transfert : un mauvais chemin ecrit a cote sans
# rien signaler, et personne ne s'en apercoit avant de chercher pourquoi le
# site n'a pas change.
DEPLOY_WP_PATH=/home/CHANGEME/domains/fammaminnou.tn/public_html

# --- Authentification SSH -------------------------------------
# Chemin de la cle privee. Laisser vide pour utiliser l'agent SSH ou la
# cle par defaut (~/.ssh/id_rsa, ~/.ssh/id_ed25519).
DEPLOY_SSH_KEY=

# --- Authentification FTPS (mode ftp uniquement) --------------
# Ne renseigner que si DEPLOY_MODE=ftp.
DEPLOY_FTP_PASSWORD=
