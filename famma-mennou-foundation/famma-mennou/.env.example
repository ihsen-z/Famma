# ============================================================
# FAMMA MENNOU — Environment (example)
# Copy to .env and adjust. NEVER commit .env.
# ============================================================
WP_ENV=local

# --- Docker / ports ---
WP_PORT=8080
PMA_PORT=8081
MAILPIT_UI_PORT=8025

# --- Database (local dev credentials only) ---
DB_NAME=famma
DB_USER=famma
DB_PASSWORD=change_me_local
DB_ROOT_PASSWORD=change_me_root_local
DB_HOST=db:3306

# --- WordPress URLs ---
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080
WP_DEBUG=1

# --- WordPress admin (used by setup.sh on first install) ---
WP_ADMIN_USER=famma_admin
WP_ADMIN_PASSWORD=change_me_admin
WP_ADMIN_EMAIL=admin@example.com
# Guillemets obligatoires : cette valeur contient une espace et .env est
# lu aussi bien par Docker Compose que par `. ./.env` dans les scripts.
WP_TITLE="FAMMA MENNOU"

# ------------------------------------------------------------
# Les variables ci-dessous sont injectees en constantes PHP par
# docker-compose.yml (WORDPRESS_CONFIG_EXTRA), prefixees FAMMA_ :
#   META_PIXEL_ID      -> FAMMA_META_PIXEL_ID
#   GA4_MEASUREMENT_ID -> FAMMA_GA4_MEASUREMENT_ID   (etc.)
# Laisser vide = fonctionnalite desactivee proprement.
# Ne pas utiliser d'apostrophe simple dans une valeur : elle casserait
# le define() genere.
# Apres toute modification : docker compose up -d  (recree wp-config).
# ------------------------------------------------------------

# --- Business / contact (owner fills these) ---
# Chaque ligne vide = ligne non affichee dans le pied de page. Rien n'est
# invente : mieux vaut une colonne courte qu'un numero imaginaire (§60).
FAMMA_WHATSAPP_NUMBER=
FAMMA_CONTACT_PHONE=
FAMMA_CONTACT_EMAIL=
FAMMA_CONTACT_ADDRESS=

# --- Reseaux sociaux (URL completes, ou vide pour masquer l'icone) ---
FAMMA_SOCIAL_FACEBOOK=
FAMMA_SOCIAL_INSTAGRAM=
FAMMA_SOCIAL_TIKTOK=
FAMMA_SOCIAL_YOUTUBE=

# --- Illustration « paiement a la livraison » du pied de page ---
# URL d'un media televerse (150x96). Vide = la colonne rend son texte seul.
FAMMA_COD_ILLUSTRATION=

# --- Tracking (owner fills these; leave blank to disable) ---
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
TIKTOK_PIXEL_ID=
GA4_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
