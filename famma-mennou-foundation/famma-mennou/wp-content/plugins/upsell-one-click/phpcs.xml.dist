<?xml version="1.0"?>
<ruleset name="Upsell One Click">
	<description>WordPress Coding Standards for Upsell One Click.</description>

	<file>.</file>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="upsell-one-click"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="upsell_oc"/>
				<element value="UpsellOneClick"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.Security.ValidatedSanitizedInput">
		<properties>
			<property name="customSanitizingFunctions" type="array">
				<element value="wc_clean"/>
				<element value="wc_format_decimal"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_product"/>
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>
</ruleset>
