				<element value="famma_child_language_switcher"/>
				<element value="famma_child_legal_bar"/>
				<element value="famma_child_lockup_markup"/>
				<element value="famma_child_loop_add_to_cart_description"/>
				<element value="famma_child_loop_add_to_cart_icon"/>
				<element value="famma_child_loop_add_to_cart_text"/>
				<element value="famma_child_loop_benefit"/>
				<element value="famma_child_loop_columns"/>
				<element value="famma_child_loop_favourite"/>
				<element value="famma_child_loop_new_badge"/>
				<element value="famma_child_loop_rating"/>
				<element value="famma_child_menu_categories"/>
				<element value="famma_child_menu_categories_host"/>
				<element value="famma_child_menu_category_item"/>
				<element value="famma_child_open_graph"/>
				<element value="famma_child_order_received_hero_title"/>
				<element value="famma_child_order_received_text"/>
				<element value="famma_child_order_received_title"/>
				<element value="famma_child_panel_account"/>
				<element value="famma_child_page_editorial"/>
				<element value="famma_child_page_lines"/>
				<element value="famma_child_page_text"/>
				<element value="famma_child_page_todo"/>
				<element value="famma_child_page_whatsapp_url"/>
				<element value="famma_child_pages_available"/>
				<element value="famma_child_preload_fonts"/>
				<element value="famma_child_price_savings"/>
				<element value="famma_child_primary_nav"/>
				<element value="famma_child_product_benefits"/>
				<element value="famma_child_product_categories"/>
				<element value="famma_child_product_category_url"/>
				<element value="famma_child_product_faq_pairs"/>
				<element value="famma_child_product_faq_panel"/>
				<element value="famma_child_product_faq_tab"/>
				<element value="famma_child_product_favourite"/>
				<element value="famma_child_product_new_badge"/>
				<element value="famma_child_product_reassurance"/>
				<element value="famma_child_product_reorder_summary"/>
				<element value="famma_child_product_review_summary"/>
				<element value="famma_child_product_scripts"/>
				<element value="famma_child_product_shipping_panel"/>
				<element value="famma_child_product_shipping_tab"/>
				<element value="famma_child_product_spec_rows"/>
				<element value="famma_child_product_specs_panel"/>
				<element value="famma_child_product_specs_tab"/>
				<element value="famma_child_product_stock_line"/>
				<element value="famma_child_product_tabs_order"/>
				<element value="famma_child_product_whatsapp_card"/>
				<element value="famma_child_reassurance_list"/>
				<element value="famma_child_register_filter_widgets"/>
				<element value="famma_child_register_shop_sidebar"/>
				<element value="famma_child_remove_front_page_hero"/>
				<element value="famma_child_remove_parent_breadcrumb"/>
