<?xml version="1.0"?>
<ruleset name="FAMMA">
	<description>
		Standards WordPress appliqués au code FAMMA (ClaudeMemo, règle 3 :
		tolérance zéro). Seul le code que nous écrivons est analysé — jamais
		le cœur WordPress, WooCommerce ni les thèmes tiers.
	</description>

	<file>wp-content/plugins/famma-core</file>
	<file>wp-content/themes/famma-child</file>
	<file>wp-content/mu-plugins</file>
	<file>scripts</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="4"/>
	<arg value="sp"/>

	<!-- Cible technique du projet (§54, ClaudeMemo règle 3). -->
	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!--
			Les trois exclusions ci-dessous découlent d'un seul choix, assumé
			et documenté : famma-core est un fichier unique consolidé
			(ClaudeMemo règle 7, docs/ARCHITECTURE.md). Un autoloader ou un
			découpage prématuré est la cause n°1 d'erreur fatale à
			l'activation (doublon de classe). À réévaluer si le plugin est
			scindé en Phase 6.
		-->
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="Generic.Files.OneObjectStructurePerFile"/>
		<exclude name="Universal.Files.SeparateFunctionsFromOO"/>
	</rule>

	<!--
		Fonctions d'assainissement fournies par WooCommerce : phpcs ne les
		connaît pas et considère donc l'entrée comme non assainie.
	-->
	<rule ref="WordPress.Security.ValidatedSanitizedInput">
		<properties>
			<property name="customSanitizingFunctions" type="array">
				<element value="wc_clean"/>
				<element value="wc_format_decimal"/>
			</property>
		</properties>
	</rule>

	<!-- Capacité déclarée dynamiquement par WooCommerce, inconnue de phpcs. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_product"/>
			</property>
		</properties>
	</rule>

	<!--
		Les scripts de scripts/ tournent sous WP-CLI et ecrivent dans un
		terminal, jamais dans une page. Les passer par esc_html() corromprait
		l'affichage sans apporter la moindre securite.
	-->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>scripts/*</exclude-pattern>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<!--
		Faux positif : le sniff prend le prefixe « famma_ » pour l'extension
		« fam », supprimee en PHP 5.1. On liste la fonction concernee plutot
		que de desactiver le controle de compatibilite.
	-->
	<rule ref="PHPCompatibility.Extensions.RemovedExtensions">
		<properties>
			<property name="functionWhitelist" type="array">
				<element value="famma_env_define_constants"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="famma-core"/>
				<element value="famma-child"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="famma"/>
				<element value="FAMMA"/>
				<element value="Famma\Core"/>
			</property>
		</properties>
	</rule>
</ruleset>
