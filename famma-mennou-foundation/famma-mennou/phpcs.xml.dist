<?xml version="1.0"?>
<ruleset name="FAMMA">
	<description>
		Standards WordPress appliqués au code FAMMA (ClaudeMemo, règle 3 :
		tolérance zéro). Seul le code que nous écrivons est analysé — jamais
		le cœur WordPress, WooCommerce ni les thèmes tiers.
	</description>

	<file>wp-content/plugins/famma-core</file>
	<file>wp-content/themes/famma-child</file>
	<file>wp-content/mu-plugins</file>
	<file>scripts</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="parallel" value="4"/>
	<arg value="sp"/>

	<!-- Cible technique du projet (§54, ClaudeMemo règle 3). -->
	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!--
			Les trois exclusions ci-dessous découlent d'un seul choix, assumé
			et documenté : famma-core est un fichier unique consolidé
			(ClaudeMemo règle 7, docs/ARCHITECTURE.md). Un autoloader ou un
			découpage prématuré est la cause n°1 d'erreur fatale à
			l'activation (doublon de classe). À réévaluer si le plugin est
			scindé en Phase 6.
		-->
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="Generic.Files.OneObjectStructurePerFile"/>
		<exclude name="Universal.Files.SeparateFunctionsFromOO"/>
	</rule>

	<!--
		Fonctions d'assainissement fournies par WooCommerce : phpcs ne les
		connaît pas et considère donc l'entrée comme non assainie.
	-->
	<rule ref="WordPress.Security.ValidatedSanitizedInput">
		<properties>
			<property name="customSanitizingFunctions" type="array">
				<element value="wc_clean"/>
				<element value="wc_format_decimal"/>
			</property>
		</properties>
	</rule>

	<!-- Capacité déclarée dynamiquement par WooCommerce, inconnue de phpcs. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_product"/>
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>

	<!--
		Les scripts de scripts/ tournent sous WP-CLI et ecrivent dans un
		terminal, jamais dans une page. Les passer par esc_html() corromprait
		l'affichage sans apporter la moindre securite.
	-->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>scripts/*</exclude-pattern>
	</rule>

	<!--
		Gabarit de wp-config.php de production : il definit des constantes du
		coeur WordPress (WP_HOME, DISALLOW_FILE_EDIT...), dont les noms sont
		imposes par WordPress. Le prefixe « famma_ » n'a pas de sens ici, et
		les renommer rendrait le gabarit inoperant.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>scripts/deploy/templates/wp-config-production.sample.php</exclude-pattern>
	</rule>

	<!--
		Les scripts de scripts/ tournent sous PHP en ligne de commande, hors de
		WordPress : WP_Filesystem n'y existe pas, et leurs variables de premier
		niveau ne polluent aucun espace global partage.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>scripts/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>scripts/*</exclude-pattern>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<!--
		Faux positif structurel : RemovedExtensionsSniff compare avec
		strpos($fn, $ext) === 0, sans exiger le souligne. Toute fonction
		« famma_* » est donc prise pour l'extension « fam » (File Alteration
		Monitor, supprimee en PHP 5.1). On liste nos fonctions plutot que de
		desactiver le controle de compatibilite PHP, utile ailleurs.

		Regenerer la liste apres ajout d'une fonction globale :
		  grep -rhoE 'famma_[a-z0-9_]+\(' wp-content/themes/famma-child \
		    wp-content/mu-plugins scripts | tr -d '(' | sort -u
	-->
	<rule ref="PHPCompatibility.Extensions.RemovedExtensions">
		<properties>
			<property name="functionWhitelist" type="array">
				<element value="famma_child_always_show_add_to_cart"/>
				<element value="famma_child_brand_link"/>
				<element value="famma_child_brand_logo"/>
				<element value="famma_child_account_choice"/>
				<element value="famma_child_account_offer_after_order"/>
				<element value="famma_child_can_offer_account"/>
				<element value="famma_child_enqueue_checkout"/>
				<element value="famma_child_cart_badge"/>
				<element value="famma_child_cart_count"/>
				<element value="famma_child_cart_fragment"/>
				<element value="famma_child_category_rank"/>
				<element value="famma_child_tel_uri"/>
				<element value="famma_child_checkout_trust"/>
				<element value="famma_child_cod_next_steps"/>
				<element value="famma_child_compare_category_order"/>
				<element value="famma_child_content_tag"/>
				<element value="famma_child_count_products"/>
				<element value="famma_child_dequeue_parent_chrome"/>
				<element value="famma_child_enqueue_favourites"/>
				<element value="famma_child_enqueue_fonts"/>
				<element value="famma_child_enqueue_home"/>
				<element value="famma_child_enqueue_layout"/>
				<element value="famma_child_enqueue_navigation"/>
				<element value="famma_child_enqueue_pages"/>
				<element value="famma_child_enqueue_product"/>
				<element value="famma_child_enqueue_product_card"/>
				<element value="famma_child_enqueue_shop"/>
				<element value="famma_child_enqueue_styles"/>
				<element value="famma_child_filter_active"/>
				<element value="famma_child_filter_on_sale"/>
				<element value="famma_child_filter_row"/>
				<element value="famma_child_filter_row_defaults"/>
				<element value="famma_child_filter_stock"/>
				<element value="famma_child_filter_tick"/>
				<element value="famma_child_filter_url"/>
				<element value="famma_child_flush_filter_counts"/>
				<element value="famma_child_font_files"/>
				<element value="famma_child_fonts_available"/>
				<element value="famma_child_footer_bottom"/>
				<element value="famma_child_footer_brand"/>
				<element value="famma_child_footer_cod"/>
				<element value="famma_child_footer_help"/>
				<element value="famma_child_footer_menu_col"/>
				<element value="famma_child_footer_socials"/>
				<element value="famma_child_gallery_carousel_options"/>
				<element value="famma_child_head_icons"/>
				<element value="famma_child_header_actions"/>
				<element value="famma_child_home_categories"/>
				<element value="famma_child_home_flush_cache"/>
				<element value="famma_child_home_hero"/>
				<element value="famma_child_home_hero_products"/>
				<element value="famma_child_home_new_products"/>
				<element value="famma_child_home_review_stats"/>
				<element value="famma_child_home_reviews"/>
