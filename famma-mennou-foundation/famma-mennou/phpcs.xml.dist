				<element value="famma_child_svg_allowed_html"/>
				<element value="famma_child_the_icon"/>
				<element value="famma_child_theme_json"/>
				<element value="famma_child_topbar"/>
				<element value="famma_child_topbar_promises"/>
				<element value="famma_child_whatsapp_number"/>
				<element value="famma_child_is_derja"/>
				<element value="famma_child_load_textdomain"/>
				<element value="famma_child_own_textdomains"/>
				<element value="famma_child_skip_translatepress_gettext"/>
				<element value="famma_child_translate_woo"/>
				<element value="famma_child_translate_woo_context"/>
				<element value="famma_child_translate_woo_plural"/>
				<element value="famma_child_translate_woo_plural_context"/>
				<element value="famma_child_woo_derja"/>
				<element value="famma_mo_build"/>
				<element value="famma_po_parse"/>
				<element value="famma_po_unquote"/>
				<element value="famma_env_define_constants"/>
				<element value="famma_legacy_urls_redirect"/>
				<element value="famma_local_mail_from"/>
				<element value="famma_local_mail_use_mailpit"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="famma-core"/>
				<element value="famma-child"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="famma"/>
				<element value="FAMMA"/>
				<element value="Famma\Core"/>
			</property>
		</properties>
	</rule>

	<!--
		Une surcharge de gabarit WooCommerce a pour role de rejouer les hooks
		du gabarit d'origine, aux memes endroits : `woocommerce_before_shop_loop`,
		`woocommerce_no_products_found`, etc. Les prefixer « famma_ » couperait
		toutes les extensions accrochees dessus — exactement ce que la
		surcharge doit eviter. L'exclusion est donc limitee au dossier
		woocommerce/ du theme, ou ces hooks sont ceux du coeur, pas les notres.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound">
		<exclude-pattern>wp-content/themes/famma-child/woocommerce/*</exclude-pattern>
	</rule>
</ruleset>
