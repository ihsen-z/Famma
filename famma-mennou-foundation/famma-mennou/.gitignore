# Secrets & local config
.env
*.env.local

# WordPress core (installed via Docker volume, not tracked)
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/
wp-config.php

# Third-party plugins & themes installed at runtime (only famma-* is tracked)
/wp-content/plugins/*
!/wp-content/plugins/famma-core/
/wp-content/themes/*
!/wp-content/themes/famma-child/

# Backups (may contain customer data)
/backups/*
!/backups/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
*.log
node_modules/
vendor/

# Configuration de deploiement (hote, identifiants, chemins)
/scripts/deploy/.env.deploy

# Le gabarit de configuration de deploiement, lui, doit etre versionne : la
# documentation demande de le copier. La regle `.env.*` de la racine du depot
# l'attrapait, d'ou cette exception — volontairement limitee au seul .example,
# jamais au .env.deploy renseigne juste au-dessus.
!/scripts/deploy/.env.deploy.example
